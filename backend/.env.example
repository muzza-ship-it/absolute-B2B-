NODE_ENV=development
PORT=5000

# Must match the frontend origin exactly in production (no wildcard CORS).
FRONTEND_URL=http://localhost:5173

# SMTP configuration for the contact form. All required for real email
# delivery — if any are missing, /api/contact will return a 502 rather
# than pretend the message was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=info@absoluteb2b.com
EMAIL_FROM=no-reply@absoluteb2b.com

# Optional — only needed if a future decision adds database persistence.
# MONGODB_URI=
